# Server Configuration
PORT=8080
NODE_ENV=development

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Cloud Tasks Configuration
GCP_PROJECT_ID=your-gcp-project-id
CLOUD_TASKS_QUEUE=transaction-tasks
CLOUD_TASKS_LOCATION=us-central1
CLOUD_RUN_SERVICE_URL=https://your-cloud-run-service-xyz.a.run.app
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=cloud-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com

# Optional Internal Authentication Secret (for local dev / direct test invocation)
INTERNAL_AUTH_TOKEN=local-dev-secret-token
